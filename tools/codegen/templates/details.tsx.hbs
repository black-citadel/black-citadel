{{#if panelImports}}import { {{#each panelImports}}{{this}}{{#unless @last}}, {{/unless}}{{/each}} } from "@components/layout/panel";
{{/if}}{{#if needsContainer}}import { Container } from "@components/base/container";
{{/if}}{{#if hasMetadata}}import { MetadataDetails } from "@components/metadata";
{{/if}}import type { {{resourceTypeName}} } from "@kubernetes/client-node";
{{#each nestedK8sTypes}}
{{#if this.isCustom}}
import { {{this.componentName}} } from "{{#if this.importPath}}{{this.importPath}}{{else}}@components/{{this.componentName}}{{/if}}";
{{else}}
import { {{this.componentName}} } from "../{{this.typeName}}/details";
{{/if}}
{{/each}}

export const {{componentName}} = ({ resourceData{{#unless hasAnyProperty}}: _resourceData{{/unless}} }: { resourceData: {{resourceTypeName}} }): JSX.Element => {
{{#each objectProperties}}
    const {{varName}} = Object.entries(resourceData.{{name}} ?? {}).map(([key, value]) => ({ label: key, value }));
{{/each}}

    const hasContent = [
{{#each objectProperties}}
        {{varName}}.length > 0,
{{/each}}
{{#each simpleProperties}}
        hasValue(resourceData.{{name}}),
{{/each}}
{{#each booleanProperties}}
        resourceData.{{name}} === true,
{{/each}}
{{#each k8sTypeProperties}}
        hasValue(resourceData.{{name}}),
{{/each}}
    ].some(Boolean);

    if (!hasContent) {
        return <div className="italic text-neutral-400 text-sm">No data</div>;
    }

    return (
        <>
{{#if hasMetadata}}
            <MetadataDetails metadata={resourceData.metadata} />

{{/if}}
{{#if hasSimpleBlock}}
            <PanelGrid
                items={[
{{#each simpleProperties}}
                    { label: {{{json displayName}}}, value: resourceData.{{name}}{{#if description}}, description: {{{json description}}}{{/if}} },
{{/each}}
                ]}
{{#if booleanProperties}}
                flags={[
{{#each booleanProperties}}
                    { label: {{{json displayName}}}, value: resourceData.{{name}}{{#if description}}, description: {{{json description}}}{{/if}} },
{{/each}}
                ]}
{{/if}}
            />

{{/if}}
{{#each objectProperties}}
            <PanelGrid title={{{json displayName}}} items={ {{varName}} } />

{{/each}}
{{#each k8sTypeProperties}}
{{#if isArray}}
{{#if hasCustomRenderer}}
{{#if isConditions}}
            {hasValue(resourceData.{{name}}) && <{{customComponentName}} {{customPropName}}={resourceData.{{name}} } />}
{{else}}
            {hasValue(resourceData.{{name}}) && (
                <Container title={{{json displayName}}} count={resourceData.{{name}}.length} collapsible defaultOpen={ {{defaultOpen}} }>
                    <{{customComponentName}} {{customPropName}}={resourceData.{{name}} } />
                </Container>
            )}
{{/if}}
{{else}}
            {hasValue(resourceData.{{name}}) && (
                <Container title={{{json displayName}}} count={resourceData.{{name}}.length} collapsible defaultOpen={ {{defaultOpen}} }>
                    {resourceData.{{name}}.map((item, index) => (
                        <PanelListItem key={index}{{#if itemTitleProperty}} title={item.{{itemTitleProperty}} }{{/if}}>
                            <{{componentName}} resourceData={item} />
                        </PanelListItem>
                    ))}
                </Container>
            )}
{{/if}}
{{else}}
{{#if hasCustomRenderer}}
            {hasValue(resourceData.{{name}}) && <{{customComponentName}} {{customPropName}}={resourceData.{{name}} } />}
{{else if isSpec}}
            {hasValue(resourceData.{{name}}) && <{{componentName}} resourceData={resourceData.{{name}} } />}
{{else}}
            {hasValue(resourceData.{{name}}) && (
                <Container title={{{json displayName}}} collapsible defaultOpen={ {{defaultOpen}} }>
                    <{{componentName}} resourceData={resourceData.{{name}} } />
                </Container>
            )}
{{/if}}
{{/if}}

{{/each}}
        </>
    )
}

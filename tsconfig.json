{
  "compilerOptions": {
    "target": "ES6",
    "allowJs": true,
    "module": "commonjs",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "*": ["node_modules/*"],
      "@components/*": ["src/renderer/components/*"],
      "@context/*": ["src/renderer/context/*"],
      "@hooks/*": ["src/renderer/hooks/*"],
      "@utils/*": ["src/renderer/utils/*"],
      "@views/*": ["src/renderer/views/*"],
      "@templates/*": ["src/renderer/templates/*"],
      "@help/*": ["src/renderer/help/*"]
    }
  },
  "include": ["src/**/*"]
}

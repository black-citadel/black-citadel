{
  "name": "black-citadel",
  "version": "1.0.5",
  "description": "Kubernetes GUI",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "npm run build:dev && electron .",
    "dev": "concurrently -k \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:main": "webpack --config webpack.main.dev.config.ts --watch",
    "dev:renderer": "NODE_ENV=development webpack serve --config webpack.dev.config.ts",
    "dev:electron": "wait-on dist/main/index.js http://localhost:3000 && WEBPACK_DEV_SERVER=true NODE_ENV=development electron .",
    "build": "webpack --config webpack.prod.config.ts",
    "build:dev": "npm run build:main:dev && npm run build:renderer:dev",
    "build:main:dev": "webpack --config webpack.main.dev.config.ts",
    "build:renderer:dev": "webpack --config webpack.renderer.dev.config.ts",
    "package": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder --publish=never",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint"
  },
  "keywords": [],
  "author": {
    "name": "Jeroen Herczeg",
    "email": "jeroen@herczeg.be"
  },
  "license": "MIT",
  "devDependencies": {
    "@headlessui/react": "^2.1.9",
    "@nicholmikey/chrome-tools": "^1.3.0",
    "@svgr/webpack": "^8.1.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.1.0",
    "@typescript-eslint/parser": "^6.1.0",
    "@vercel/webpack-asset-relocator-loader": "1.7.3",
    "axios": "^1.7.7",
    "concurrently": "^9.2.0",
    "css-loader": "^6.8.1",
    "electron": "^25.9.8",
    "electron-builder": "^26.0.12",
    "eslint": "^8.45.0",
    "eslint-plugin-import": "^2.27.5",
    "fork-ts-checker-webpack-plugin": "^8.0.0",
    "html-webpack-plugin": "^5.6.4",
    "node-loader": "^2.0.0",
    "postcss-loader": "^7.3.3",
    "postcss-nesting": "^13.0.2",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.1",
    "typescript": "~5.1.6",
    "wait-on": "^8.0.4",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "build": {
    "appId": "com.blackcitadel.app",
    "productName": "Black Citadel",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icons/mac/icon.icns",
      "sign": "scripts/mac-sign.js",
      "target": [
        "dmg"
      ],
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "icons/windows/icon.ico",
      "artifactName": "${name}-${version}-setup.${ext}"
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "snap"
      ],
      "category": "Development",
      "icon": "icons/linux",
      "maintainer": "Jeroen Herczeg <jeroen@herczeg.be>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.3.1",
    "@fontsource/inter": "^5.1.0",
    "@heroicons/react": "^2.1.5",
    "@kubernetes/client-node": "^0.22.0",
    "@modelcontextprotocol/sdk": "^1.12.3",
    "@monaco-editor/react": "^4.6.0",
    "@protoku-bv/design-system": "^0.1.0",
    "@reduxjs/toolkit": "^2.2.8",
    "@types/express": "^4.17.23",
    "@types/uuid": "^10.0.0",
    "@xterm/addon-attach": "^0.11.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.8.2",
    "autoprefixer": "^10.4.14",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron-squirrel-startup": "^1.0.0",
    "express": "^5.1.0",
    "framer-motion": "^11.11.7",
    "js-yaml": "^4.1.0",
    "monaco-editor": "^0.52.2",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.1.2",
    "tailwindcss": "3.3.3",
    "uuid": "^11.1.0"
  }
}
